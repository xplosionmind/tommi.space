<article class='razzmatazz box'>
	<link rel=stylesheet href=https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css />
	<script src=https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js></script>
	<div id=map></div>
	{% for place in places %}
		{% if place.name == title %}
			<script>
				const map = new maplibregl.Map({
					container: 'map',
					style: 'https://tiles.openfreemap.org/styles/liberty',
					center: [{{ place.lon }}, {{ place.lat }}],
					zoom: 7
				});
				const marker = new maplibregl.Marker({color: '#EC0860'})
					.setLngLat([{{ place.lon }}, {{ place.lat }}])
					.addTo(map);
			</script>
		{% endif %}
	{% endfor %}

	{% if lang == 'it' %}
		<h2>📍 Luogo speciale</h2>
		<p>Questo è uno dei <q>luoghi di Tommi</q>, ovvero posti nel mondo che hanno per me un significato particolare.
		<div class=flex>
			<a class='blue button' href=/luoghi/>Tutti i luoghi</a>
		</div>
	{% else %}
		<h2>📍 Special place</h2>
		<p>This is one of <q>Tommi’s places</q>, corners of the world that have a special meaning for me.
		<div class=flex>
			<a class='blue button' href=/places/>All the places</a>
		</div>
	{% endif %}
</article>
