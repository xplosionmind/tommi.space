{
	"description": "Tommi’s personal website",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git@codeberg.org:tommi/tommi.space.git"
	},
	"tasks": {
		"eleventy:watch": "ELEVENTY_ENV=development dx eleventy --serve --watch --incremental",
		"eleventy:build": "ELEVENTY_ENV=production dx eleventy",
		"sass:watch": "dx sass --watch --style=compressed styles:www",
		"sass:build": "dx sass --style=compressed styles/:www",
		"start": "deno task eleventy:watch & deno task sass:watch",
		"build": "deno task eleventy:build && deno task sass:build",
		"start-naked": "CSS_NAKED=true deno run start",
		"build-naked": "CSS_NAKED=true deno run build",
		"debug": "DEBUG='Eleventy*' deno run build"
	},
	"imports": {
		"@11ty/eleventy": "npm:@11ty/eleventy@^3.1.5",
		"@11ty/eleventy-dev-server": "npm:@11ty/eleventy-dev-server@^3.0.0-alpha.6",
		"@11ty/eleventy-fetch": "npm:@11ty/eleventy-fetch@^5.1.2",
		"@11ty/eleventy-img": "npm:@11ty/eleventy-img@^6.0.4",
		"@11ty/eleventy-plugin-syntaxhighlight": "npm:@11ty/eleventy-plugin-syntaxhighlight@^5.0.2",
		"@saiballo/eleventy-plugin-validate-html": "npm:@saiballo/eleventy-plugin-validate-html@^1.0.4",
		"@uncenter/eleventy-plugin-toc": "npm:@uncenter/eleventy-plugin-toc@^2.1.2",
		"csv-parse": "npm:csv-parse@^6.2.1",
		"eleventy-plugin-embed-everything": "npm:eleventy-plugin-embed-everything@^1.21.2",
		"eleventy-plugin-robotstxt": "npm:eleventy-plugin-robotstxt@^1.0.2",
		"html-minifier-next": "npm:html-minifier-next@^6.2.6",
		"js-yaml": "npm:js-yaml@^4.1.1",
		"markdown-it": "npm:markdown-it@^14.1.1",
		"markdown-it-anchor": "npm:markdown-it-anchor@^9.2.0",
		"markdown-it-attrs": "npm:markdown-it-attrs@^4.3.1",
		"markdown-it-footnote": "npm:markdown-it-footnote@^4.0.0",
		"markdown-it-mark": "npm:markdown-it-mark@^4.0.0",
		"markdown-it-task-lists": "npm:markdown-it-task-lists@^2.1.1",
		"pagefind": "npm:pagefind@^1.5.2",
		"sass": "npm:sass@^1.99.0",
		"utopia-core-scss": "npm:utopia-core-scss@^1.3.1"
	},
	"allowScripts": ["npm:@parcel/watcher@2.5.4", "npm:@parcel/watcher@2.5.6", "npm:sharp@0.33.5"]
}
